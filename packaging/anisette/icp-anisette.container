# Podman Quadlet: anisette server for icp, reachable from THIS machine only.
# Install (rootless, no sudo):
#   mkdir -p ~/.config/containers/systemd
#   cp icp-anisette.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload && systemctl --user start icp-anisette.service
# The service is generated by Quadlet; [Install] below makes it start at login.
[Unit]
Description=Anisette server for icp (loopback only)

[Container]
Image=docker.io/dadoum/anisette-v3-server:latest
ContainerName=icp-anisette
# 127.0.0.1 on purpose: the server is unauthenticated, never publish it on 0.0.0.0
PublishPort=127.0.0.1:6969:6969
# keeps the provisioned identity between restarts (so Apple sees one stable "device")
Volume=icp-anisette-data:/home/Chester/.config/anisette-v3/lib/

[Service]
Restart=always

[Install]
WantedBy=default.target
